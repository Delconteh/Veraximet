<Application x:Class="Veraximet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Veraximet">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Beautify.Controls;component/Themes/Generic.xaml" />

                <ResourceDictionary Source="/Veraximet.UI;component/Fonts/FontSizes.xaml"/>
                <ResourceDictionary Source="/Veraximet.UI;component/Themes/Typography.xaml"/>
                <ResourceDictionary Source="/Veraximet.UI;component/Themes/Brushes.xaml" />
                <ResourceDictionary Source="/Veraximet.UI;component/Styles/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
