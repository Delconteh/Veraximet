<UserControl x:Class="Veraximet.Wpf.Features.Verification.Views.VerificationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Veraximet.Wpf.Features.Verification.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="24,20,24,20" Background="{DynamicResource Shell.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="METROLOGY / NEW VERIFICATION" Style="{StaticResource Workspace.EyebrowTextStyle}"/>
                <TextBlock Text="New verification" Style="{StaticResource Workspace.PageTitleTextStyle}" Margin="0,5,0,3"/>
                <TextBlock Style="{StaticResource Workspace.DescriptionTextStyle}">
                    <Run Text="{Binding Instrument.Code, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Instrument.Name, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsEditable}">
            <StackPanel Margin="0,0,8,0">
                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Verification details" Style="{StaticResource Workspace.SectionTitleTextStyle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="0.55*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="OPERATOR *" Style="{StaticResource Workspace.FilterLabelTextStyle}"/>
                                <TextBox Margin="0,6,0,0" MaxLength="120" Text="{Binding PerformedBy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Workspace.EditorTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DATE (YYYY-MM-DD) *" Style="{StaticResource Workspace.FilterLabelTextStyle}"/>
                                <TextBox Margin="0,6,0,0" Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Workspace.EditorTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="UNIT *" Style="{StaticResource Workspace.FilterLabelTextStyle}"/>
                                <TextBox Margin="0,6,0,0" MaxLength="24" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Workspace.EditorTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="NOTES / REFERENCE STANDARD / CONDITIONS" Style="{StaticResource Workspace.FilterLabelTextStyle}" Margin="0,14,0,6"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Style="{StaticResource Workspace.EditorMultilineTextBoxStyle}" MinHeight="55"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Verification points" Style="{StaticResource Workspace.SectionTitleTextStyle}"/>
                        <TextBlock Text="Enter readings in the same unit as the reference. Add or remove readings as needed." TextWrapping="Wrap" Style="{StaticResource Workspace.DescriptionTextStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="− Last point" Command="{Binding RemoveLastPointCommand}" IsEnabled="{Binding CanRemovePoint}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="+ Add point" Command="{Binding AddPointCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Points}" AlternationCount="2147483647">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <Border DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Workspace.ConformityBadgeStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutcomeCode}" Value="Conforming">
                                                            <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurfaceBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Workspace.AccentBorderBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OutcomeCode}" Value="Nonconforming">
                                                            <Setter Property="Background" Value="{DynamicResource Workspace.DangerSurfaceBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ErrorBorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Outcome}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Order, StringFormat='Verification point {0:00}'}" Style="{StaticResource Workspace.SectionTitleTextStyle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="REFERENCE *" Style="{StaticResource Workspace.FilterLabelTextStyle}"/>
                                            <TextBox Margin="0,6,0,0" Text="{Binding ReferenceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Workspace.EditorTextBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="MPE (±) *" Style="{StaticResource Workspace.FilterLabelTextStyle}"/>
                                            <TextBox Margin="0,6,0,0" Text="{Binding MpeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Workspace.EditorTextBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="DESCRIPTION / MODE" Style="{StaticResource Workspace.FilterLabelTextStyle}"/>
                                            <TextBox Margin="0,6,0,0" MaxLength="300" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Workspace.EditorTextBoxStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,18,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.85*"/>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="READINGS" Style="{StaticResource Workspace.FilterLabelTextStyle}" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Measurements}" AlternationCount="2147483647">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,7">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Order, StringFormat='M{0}'}" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource MutedTextBrush}"/>
                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Workspace.EditorTextBoxStyle}"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <WrapPanel>
                                                <Button Content="+ Reading" Command="{Binding AddMeasurementCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,5"/>
                                                <Button Content="− Last" Command="{Binding RemoveLastMeasurementCommand}" IsEnabled="{Binding CanRemoveMeasurement}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,5"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ERROR DISTRIBUTION" Style="{StaticResource Workspace.FilterLabelTextStyle}" Margin="0,0,0,8"/>
                                            <local:MeasurementPlot Data="{Binding Plot}"/>
                                            <TextBlock Text="Green: within MPE · Red: outside MPE · Dashed: mean error" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,0,0,12"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="MEAN" Style="{StaticResource Workspace.DetailLabelTextStyle}" />
                                            <TextBlock Text="{Binding MeanLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="MEAN ERROR" Style="{StaticResource Workspace.DetailLabelTextStyle}" />
                                            <TextBlock Text="{Binding MeanErrorLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="MAX ABS. ERROR" Style="{StaticResource Workspace.DetailLabelTextStyle}" />
                                            <TextBlock Text="{Binding MaxErrorLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="STD. DEVIATION" Style="{StaticResource Workspace.DetailLabelTextStyle}" />
                                            <TextBlock Text="{Binding DeviationLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,8">
                                            <TextBlock Text="RANGE" Style="{StaticResource Workspace.DetailLabelTextStyle}" />
                                            <TextBlock Text="{Binding RangeLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Only observed readings are evaluated. Measurement uncertainty and fitness for production are not assessed." Style="{StaticResource Workspace.DescriptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource KpiCardStyle}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Outcome}" Style="{StaticResource Workspace.SectionTitleTextStyle}"/>
                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Save verification" Command="{Binding SaveCommand}" IsEnabled="{Binding IsEditable}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
