<UserControl x:Class="Veraximet.Wpf.Features.Verification.Views.VerificationHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Veraximet.Wpf.Features.Verification.Views"
             mc:Ignorable="d" xmlns:view="clr-namespace:Veraximet.Wpf.Features.Verification.Views"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="METROLOGY / HISTORY" Style="{StaticResource Workspace.EyebrowTextStyle}"/>
                <TextBlock Text="Verification history" Style="{StaticResource Workspace.PageTitleTextStyle}" Margin="0,6,0,4"/>
                <TextBlock Text="Review recorded checks, individual readings and historical decisions." Style="{StaticResource Workspace.DescriptionTextStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelStyle}">
                <DataGrid ItemsSource="{Binding Records}"  SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource Workspace.DataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DeadlineRowStyle}">
                            <Setter Property="Background" Value="#dbdbdb"/>
                            <Setter Property="Padding" Value="5 20 0 0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd MMM yyyy}" Width="*" />
                        <DataGridTextColumn Header="CODE" Binding="{Binding InstrumentCode}" Width="*"/>
                        <DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,5,0">
                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.InstrumentName, TargetNullValue='Select a verification'}" Style="{StaticResource Workspace.SectionTitleTextStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Selected.PerformedBy, StringFormat='Operator: {0}'}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding Selected.Unit, StringFormat='Unit: {0}'}" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding Selected.DecisionRule, StringFormat='Rule: {0}'}" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding RuleNotice}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Selected.Notes}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding SelectedPoints}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Point.ReferenceValue, StringFormat='Reference: {0:G29}'}" Style="{StaticResource Workspace.SectionTitleTextStyle}"/>
                                        <TextBlock Text="{Binding Point.Description}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Outcome}" Margin="0,6,0,8" FontWeight="SemiBold"/>
                                        <view:MeasurementPlot Data="{Binding Plot}" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,8,8">
                                                <TextBlock Text="MEAN" Style="{StaticResource Workspace.DetailLabelTextStyle}" />
                                                <TextBlock Text="{Binding MeanLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,8">
                                                <TextBlock Text="MEAN ERROR" Style="{StaticResource Workspace.DetailLabelTextStyle}" />
                                                <TextBlock Text="{Binding MeanErrorLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,8">
                                                <TextBlock Text="MAX ABS. ERROR" Style="{StaticResource Workspace.DetailLabelTextStyle}" />
                                                <TextBlock Text="{Binding MaxErrorLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,8">
                                                <TextBlock Text="STD. DEVIATION" Style="{StaticResource Workspace.DetailLabelTextStyle}" />
                                                <TextBlock Text="{Binding DeviationLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,8">
                                                <TextBlock Text="RANGE" Style="{StaticResource Workspace.DetailLabelTextStyle}" />
                                                <TextBlock Text="{Binding RangeLabel}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="RECORDED READINGS" Style="{StaticResource Workspace.FilterLabelTextStyle}" Margin="0,10,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Point.Measurements}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Workspace.InputBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,5,5">
                                                        <TextBlock Text="{Binding StringFormat={}{0:G29}}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Historical outcome is stored. Statistics are reproduced for the supported decision rule only. No ISO conformity is claimed." Style="{StaticResource Workspace.DescriptionTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
