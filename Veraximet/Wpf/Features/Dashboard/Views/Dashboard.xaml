<UserControl x:Class="Veraximet.Wpf.Features.Dashboard.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Veraximet.Wpf.Features.Dashboard.Views"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1600">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#101719" />
        <SolidColorBrush x:Key="CardBrush" Color="#192326" />
        <SolidColorBrush x:Key="CardAltBrush" Color="#1D292C" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#304044" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E9F0ED" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8FA49F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#82B9A8" />
        <SolidColorBrush x:Key="WarningBrush" Color="#E1BC78" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E49A93" />

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border" BasedOn="{StaticResource KpiCardStyle}">
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#253538" />
            <Setter Property="BorderBrush" Value="#3C5254" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#31474A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1C2A2D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeadlineHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202E31" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="15,0,9,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="43" />
        </Style>

        <Style x:Key="DeadlineRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Height" Value="49" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#263538" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#294640" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeadlineCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,0,9,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="CodeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="DeadlineTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DeadlineTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Style.Triggers>

                <DataTrigger Binding="{Binding StatusCode}" Value="Overdue">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusCode}" Value="DueSoon">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto" 
                  Background="{StaticResource SurfaceBrush}">
        <Grid Margin="34,30,34,32" MinWidth="960"  HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <Grid Grid.Row="0" Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="OPERATIONS / OVERVIEW"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                                />
                    <TextBlock Text="Dashboard" Margin="0,8,0,5"
                               FontSize="29" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Measurement instrument status and upcoming verifications"
                               FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="LAST UPDATED" HorizontalAlignment="Right"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding LastUpdatedLabel, FallbackValue=Not loaded}"
                                   Margin="0,5,0,0" HorizontalAlignment="Right"
                                   FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Reload data from the database"
                            Content="↻  Refresh" />
                </StackPanel>
            </Grid>


            <Border Grid.Row="1" Background="#20322F" BorderBrush="#385B53"
                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,18"
                    Padding="13,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Loading instrument data…" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" />
                    <ProgressBar Height="3" IsIndeterminate="True" Background="#304641"
                                 Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="#342628" BorderBrush="#7B4848"
                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,18"
                    Padding="13,11">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage, FallbackValue=Could not load dashboard data.}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>


            <Grid Grid.Row="3" Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="REGISTERED INSTRUMENTS" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding TotalInstruments, StringFormat={}{0:N0}, FallbackValue=—}"
                                   FontSize="34" FontWeight="Medium" Margin="0,12,0,8"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Total assets in the register" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="AVAILABLE" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding AvailableInstruments, StringFormat={}{0:N0}, FallbackValue=—}"
                                   FontSize="34" FontWeight="Medium" Margin="0,12,0,8"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Approved for use" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="OVERDUE" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding OverdueInstruments, StringFormat={}{0:N0}, FallbackValue=—}"
                                   FontSize="34" FontWeight="Medium" Margin="0,12,0,8"
                                   Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="Verification date exceeded" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="DUE SOON" FontSize="10"
                                   FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding DueSoonInstruments, StringFormat={}{0:N0}, FallbackValue=—}"
                                   FontSize="34" FontWeight="Medium" Margin="0,12,0,8"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="Within the configured window" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>


            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" MinWidth="620" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Priority deadlines" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Instruments requiring near-term attention"
                                           FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenInstrumentsCommand}"
                                    Content="Open register" />
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource StrokeBrush}"
                                Height="1" Margin="0,21,0,15" />

                        <Grid Grid.Row="2" Height="auto">
                            <DataGrid x:Name="DeadlinesGrid"
                                      ItemsSource="{Binding UpcomingDeadlines}"
                                      SelectedItem="{Binding SelectedDeadline, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="None"
                                      ColumnHeaderStyle="{StaticResource DeadlineHeaderStyle}"
                                      RowStyle="{StaticResource DeadlineRowStyle}"
                                      CellStyle="{StaticResource DeadlineCellStyle}"
                                      Background="{StaticResource CardBrush}"
                                      Foreground="{StaticResource PrimaryTextBrush}"
                                      BorderThickness="0" RowHeaderWidth="0"
                                      ColumnHeaderHeight="43" RowHeight="49"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserResizeRows="False" CanUserReorderColumns="False"
                                      AlternationCount="1"
                                      HorizontalGridLinesBrush="{StaticResource StrokeBrush}"
                                      VerticalGridLinesBrush="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CODE" Width="110"
                                                        Binding="{Binding InstrumentCode}"
                                                        ElementStyle="{StaticResource CodeTextStyle}" />
                                    <DataGridTextColumn Header="INSTRUMENT" Width="*"
                                                        Binding="{Binding InstrumentName}"
                                                        ElementStyle="{StaticResource DeadlineTextStyle}" />
                                    <DataGridTextColumn Header="DUE DATE" Width="120"
                                                        Binding="{Binding DueDate, StringFormat={}{0:dd MMM yyyy}}"
                                                        ElementStyle="{StaticResource DeadlineTextStyle}" />
                                    <DataGridTemplateColumn Header="STATUS" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Style="{StaticResource StatusTextStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=DeadlinesGrid, Path=HasItems}" Value="False" />
                                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                                    <Condition Binding="{Binding HasError}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="No upcoming deadlines" FontWeight="SemiBold"
                                           FontSize="14" HorizontalAlignment="Center" />
                                <TextBlock Text="There are no items in the selected period."
                                           FontSize="12" Margin="0,8,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Select an instrument to view its details" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenSelectedInstrumentCommand}" IsEnabled="{Binding CanOpenSelected}"
                                    Content="View instrument" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Quality signals" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Exceptions requiring review"
                                   FontSize="12" Margin="0,6,0,21"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <Border Height="1" Background="{StaticResource StrokeBrush}"
                                Margin="0,0,0,20" />
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nonconforming" FontSize="13"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Last verification failed"
                                           FontSize="11" Margin="0,5,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding NonconformingInstruments, StringFormat={}{0:N0}, FallbackValue=—}"
                                       FontSize="24" FontWeight="Medium"
                                       Foreground="{StaticResource DangerBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource StrokeBrush}"
                                Margin="0,0,0,20" />
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Suspended" FontSize="13"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Temporarily unavailable"
                                           FontSize="11" Margin="0,5,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SuspendedInstruments, StringFormat={}{0:N0}, FallbackValue=—}"
                                       FontSize="24" FontWeight="Medium"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource StrokeBrush}"
                                Margin="0,0,0,20" />
                        <TextBlock Text="Operational status and verification compliance are tracked independently."
                                   FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
