<Window x:Class="Veraximet.Wpf.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Veraximet.Wpf.Shell.Views" xmlns:shell="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
        mc:Ignorable="d"  Title="Veraximet — Instrument Control"
        Width="1810" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:viewmodels="clr-namespace:Veraximet.Wpf.Shell.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowVM}"
        Height="910"
        MinWidth="1520"
        MinHeight="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#101719" 
        Foreground="#E9F0ED"
        FontFamily="{DynamicResource Font.Primary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">


    <Window.Resources>
        <ResourceDictionary>

            <SolidColorBrush x:Key="Shell.Background" Color="#101719" />
            <SolidColorBrush x:Key="Shell.TitleBar" Color="#131D1F" />
            <SolidColorBrush x:Key="Shell.Sidebar" Color="#172123" />
            <SolidColorBrush x:Key="Shell.SidebarHover" Color="#223235" />
            <SolidColorBrush x:Key="Shell.SidebarSelected" Color="#29423D" />
            <SolidColorBrush x:Key="Shell.Border" Color="#2B3D3F" />
            <SolidColorBrush x:Key="Shell.Text" Color="#E9F0ED" />
            <SolidColorBrush x:Key="Shell.Muted" Color="#8DA39D" />
            <SolidColorBrush x:Key="Shell.Accent" Color="#86BDAC" />
            <SolidColorBrush x:Key="Shell.AccentDim" Color="#4D7C71" />

            <Style x:Key="Shell.NavButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="12,2" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{StaticResource Shell.Muted}" />
                <Setter Property="Background" Value="{StaticResource Shell.Sidebar}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="{DynamicResource Font.Size.Navigation}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="ButtonSurface"
                                    CornerRadius="9"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  RecognizesAccessKey="True" />
                                </Border>
                                <Border HorizontalAlignment="Left"
                                    Width="3"
                                    Margin="0,11,0,11"
                                    CornerRadius="2"
                                    Background="{TemplateBinding BorderBrush}" />
                            </Grid>
                            <ControlTemplate.Triggers>


                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{StaticResource Shell.AccentDim}" />
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="{StaticResource Shell.SidebarHover}" />
                                </Trigger>
                                <!--<Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ButtonSurface"
                                        Property="BorderBrush"
                                        Value="{StaticResource Shell.AccentDim}" />
                                </Trigger>-->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Shell.TitleButton" TargetType="Button">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="50" />
                <Setter Property="Foreground" Value="{StaticResource Shell.Muted}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ChromeSurface" Background="{TemplateBinding Background}" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChromeSurface"
                                        Property="Background" Value="#29393B" />
                                    <Setter Property="Foreground" Value="{StaticResource Shell.Text}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ChromeSurface"
                                        Property="Background" Value="#1E2A2C" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Shell.CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource Shell.TitleButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseSurface" Background="{TemplateBinding Background}" CornerRadius="3" Margin="0 0 4 0">
                                <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseSurface"
                                        Property="Background" Value="#A94343" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CloseSurface"
                                        Property="Background" Value="#8F3434" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="60"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0" 
                            CornerRadius="30" 
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border ClipToBounds="True" CornerRadius="0" Background="{StaticResource Shell.Background}" BorderBrush="{StaticResource Shell.Border}" BorderThickness="2" >

        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Shell.TitleBar}" CornerRadius="15 15 0 0">

                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="252" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="27" Height="27" CornerRadius="7"
                        Background="#27423B" BorderBrush="#4F8072" BorderThickness="1">
                            <Image Source="/Veraximet.UI;component/Assets/Vx_Logo.png" VerticalAlignment="Bottom" HorizontalAlignment="Center"  Width="40" Height="40" Margin="0,0,0,-8"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VERAXIMET" FontSize="{DynamicResource Font.Size.Brand}" FontWeight="SemiBold"
                               Foreground="{StaticResource Shell.Text}" />
                            <TextBlock Text="INDUSTRIAL METROLOGY" FontSize="{DynamicResource Font.Size.BrandCaption}"
                               Foreground="{StaticResource Shell.Muted}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Column="1"
                       Text="Instrument Control &amp; Verification"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Shell.Muted}"
                       FontSize="{DynamicResource Font.Size.HeaderCaption}"
                       Margin="20,0,0,0" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource Shell.TitleButton}"
                        Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" Data="M0,5 L12,5" Width="12" Height="10" />
                        </Button>
                        <Button Style="{StaticResource Shell.TitleButton}"
                        Click="Resize_Click" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="12" Height="12">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.35" Data="M1,1 L11,1 L11,11 L1,11 Z">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" Data="M3,1 L11,1 L11,9 L9,9 M1,4 L9,4 L9,12 L1,12 Z">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource Shell.CloseButton}" Command="{Binding CloseWindowCommand}"
                        ToolTip="Close" AutomationProperties.Name="Close window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.45" Data="M1,1 L11,11 M11,1 L1,11"
                          Width="12" Height="12" />
                        </Button>
                    </StackPanel>
                    <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                    Background="{StaticResource Shell.Border}" />
                </Grid>

            </Border>
            
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="70" />
                    <ColumnDefinition Width="5"  />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Shell.Sidebar}"
                    BorderBrush="{StaticResource Shell.Border}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="26,31,0,14">
                            <TextBlock Text="WORKSPACE" FontSize="{DynamicResource Font.Size.SectionLabel}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Shell.Muted}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">

                            <ItemsControl ItemsSource="{Binding MenuItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <RadioButton Style="{StaticResource Shell.NavButton}"
                                                        GroupName="Navigation"
                                                        ToolTip="{Binding Title}"
                                                        AutomationProperties.Name="{Binding Title}"
                                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="25" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <materialDesign:PackIcon
                        Kind="{Binding IconKey}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Foreground="{Binding Foreground,
                            RelativeSource={RelativeSource AncestorType=RadioButton}}" />

                                                <TextBlock
                        Grid.Column="1"
                        Text="{Binding Title}"
                        VerticalAlignment="Center" />
                                            </Grid>

                                        </RadioButton>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--<RadioButton Command="{Binding NavigateCommand}" GroupName="Sidebar"  CommandParameter="{Binding}"
                                ToolTip="Dashboard" AutomationProperties.Name="Dashboard" Style="{StaticResource Shell.NavButton}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="MonitorDashboard" 
                                                             VerticalAlignment="Center" HorizontalAlignment="Left"
                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>

                                    <TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>

                            <RadioButton Command="{Binding NavigateCommand}" GroupName="Sidebar" CommandParameter="{Binding}"
                                ToolTip="Instrument register" AutomationProperties.Name="Instruments" Style="{StaticResource Shell.NavButton}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Kind="Ruler" 
                                                             VerticalAlignment="Center" HorizontalAlignment="Left"
                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Grid.Column="1" Text="Instruments" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>

                            <RadioButton Command="{Binding NavigateCommand}" GroupName="Sidebar" CommandParameter="{Binding}"
                                ToolTip="Verification history" AutomationProperties.Name="Verifications" Style="{StaticResource Shell.NavButton}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Kind="PaperCheck" 
                                                             VerticalAlignment="Center" HorizontalAlignment="Left"
                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Grid.Column="1" Text="Verifications" VerticalAlignment="Center" />
                                </Grid>
                            </RadioButton>-->
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="17,20,17,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="1" Margin="5,0,5,17"
                                Background="{StaticResource Shell.Border}" />
                            <Border Grid.Row="1" Background="#1D2B2C" 
                                BorderBrush="{StaticResource Shell.Border}" BorderThickness="1"
                                Padding="13,12" CornerRadius="9">
                                <StackPanel>
                                    <TextBlock Text="Settings" FontSize="{DynamicResource Font.Size.SectionLabel}"
                                           FontWeight="SemiBold" Foreground="{StaticResource Shell.Text}" />
                                    <TextBlock Text="Software configurations" TextWrapping="Wrap" MaxHeight="50" 
                                           FontSize="{DynamicResource Font.Size.Helper}" Margin="0,5,0,0"
                                           Foreground="{StaticResource Shell.Muted}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <shell:GridSplitter Grid.Column="1"  Background="Transparent"
                                    HorizontalAlignment="Stretch"  
                                    VerticalAlignment="Stretch"/>

                <Grid Grid.Column="2" Background="{StaticResource Shell.Background}">
                    <ContentControl x:Name="NavigationOutlet" HorizontalAlignment="Stretch"
                                    Content="{Binding CurrentView}"
                                    Focusable="False" />


                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Preparing workspace"
                               Foreground="{StaticResource Shell.Text}"
                               FontSize="{DynamicResource Font.Size.EmptyTitle}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                        <TextBlock Text="Waiting for the initial view"
                               Foreground="{StaticResource Shell.Muted}"
                               FontSize="{DynamicResource Font.Size.EmptyDescription}" Margin="0,9,0,18"
                               HorizontalAlignment="Center" />
                        <ProgressBar Width="130" Height="3" IsIndeterminate="True"
                                 Background="{StaticResource Shell.Border}"
                                 Foreground="{StaticResource Shell.Accent}"
                                 BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" CornerRadius="2 2 7 7" Background="{StaticResource Shell.TitleBar}" BorderBrush="{StaticResource Shell.Border}" BorderThickness="0 1 0 0">

                <Grid   Height="30">

                    <TextBlock  FontSize="{DynamicResource Font.Size.Helper}" Text="© 2026 | Delconte" Opacity="0.7" FontStyle="Italic" FontWeight="DemiBold" Margin="20 3 5 5" VerticalAlignment="Center"/>
                    <shell:ResizeGrip  WindowChrome.ResizeGripDirection="BottomRight" Background="Transparent" VerticalAlignment="Center" Margin="5 0"
                   HorizontalAlignment="Right"
                   Width="16" Height="16" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
