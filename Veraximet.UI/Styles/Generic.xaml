<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">




    <Style x:Key="KpiCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="PanelStyle" TargetType="Border" BasedOn="{StaticResource KpiCardStyle}">
        <Setter Property="Padding" Value="22" />
    </Style>


    <Style x:Key="Workspace.ActionButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Button}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource Workspace.ActionButtonBase}">
        <Setter Property="Background" Value="{StaticResource Workspace.ButtonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Workspace.ButtonBorderBrush}" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource Workspace.ActionButtonBase}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>


    <Style x:Key="Workspace.EyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.PageEyebrow}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Workspace.PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.PageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Workspace.DescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.PageDescription}" />
    </Style>
    <Style x:Key="Workspace.SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.PanelTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Workspace.FilterLabelTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.SectionLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>


    <Style x:Key="Workspace.SearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Workspace.InputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,10" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Input}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="Workspace.EditorTextBoxStyle" TargetType="TextBox"
           BasedOn="{StaticResource Workspace.SearchTextBoxStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Opacity" Value="0.68" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Workspace.EditorMultilineTextBoxStyle" TargetType="TextBox"
           BasedOn="{StaticResource Workspace.EditorTextBoxStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="Workspace.ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Input}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background"
                                    Value="{StaticResource Workspace.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background"
                                    Value="{StaticResource Workspace.AccentSurfaceBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="Workspace.FilterComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Workspace.InputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Input}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Workspace.ComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="FieldChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid Margin="13,0,11,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Path Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Data="M0,0 L5,5 L10,0" StrokeThickness="1.5"
                                      Stroke="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="DropDownToggle" Focusable="False"
                                      Background="Transparent" BorderThickness="0"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               Placement="Bottom" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource CardAltBrush}"
                                    BorderBrush="{StaticResource Workspace.ButtonBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="5"
                                    MinWidth="{Binding ActualWidth, ElementName=FieldChrome}">
                                <ScrollViewer MaxHeight="260" CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldChrome" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="DeadlineHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Workspace.HeaderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="15,0,9,0" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.TableHeader}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="43" />
    </Style>
    <Style x:Key="DeadlineRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Height" Value="49" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Workspace.RowHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Workspace.RowSelectedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DeadlineCellStyle" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="15,0,9,0" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="Workspace.DataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DeadlineHeaderStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource DeadlineRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource DeadlineCellStyle}" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="ColumnHeaderHeight" Value="43" />
        <Setter Property="RowHeight" Value="49" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>


    <Style x:Key="CodeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.TableCell}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="DeadlineTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.TableCell}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="StatusTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DeadlineTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusCode}" Value="Overdue">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusCode}" Value="DueSoon">
                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Workspace.ConformityBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConformityStatusCode}" Value="Conforming">
                <Setter Property="Background" Value="{StaticResource Workspace.AccentSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource Workspace.AccentBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ConformityStatusCode}" Value="Nonconforming">
                <Setter Property="Background" Value="{StaticResource Workspace.DangerSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource Workspace.ErrorBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Workspace.ConformityTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DeadlineTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConformityStatusCode}" Value="Conforming">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ConformityStatusCode}" Value="Nonconforming">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Workspace.OperationalTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DeadlineTextStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding OperationalStatusCode}" Value="Suspended">
                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding OperationalStatusCode}" Value="Archived">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Workspace.DueTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource DeadlineTextStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding DueStatusCode}" Value="Overdue">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DueStatusCode}" Value="DueSoon">
                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="Workspace.DetailLabelTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource Workspace.FilterLabelTextStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Workspace.DetailValueTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.TableCell}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Workspace.DetailMonoValueTextStyle" TargetType="TextBlock"
           BasedOn="{StaticResource Workspace.DetailValueTextStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
</ResourceDictionary>